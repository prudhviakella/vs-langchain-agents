# Copy to .env (same folder). Never commit .env.
# The deployed supervisor (agent/supervisor/deployment.json -> runtime_arn):
SUPERVISOR_ARN=arn:aws:bedrock-agentcore:us-east-1:234360896963:runtime/ecom_supervisor-zQcOQ0ExQW
AWS_REGION=us-east-1
# Store: a real DynamoDB table, created on first start if missing (on-demand, cents)
APP_STORE=dynamodb
APP_TABLE=ecom-webapp
# Local only: any long random string. On AWS: SESSION_SECRET_ID (Secrets Manager) instead.
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# ── Admin console (AgentOps) ──
# Who sees /admin. Unset or * = every user (the default). A list = only those users.
# ADMIN_USERS=prudhvi,anil
# USD per 1M tokens. Leave unset until you know gpt-6-sol's price — costs then show "—".
# MODEL_PRICES={"gpt-6-sol": {"input": 0.00, "output": 0.00}}
# Knowledge base browser: Pinecone key (and OpenAI for "search by meaning") — or the *_SECRET_ID variables
PINECONE_API_KEY=pcsk_change-me
OPENAI_API_KEY=sk-change-me
