# Copy to .env and fill in. Never commit .env.

# ── Postgres (RDS) — either the PG* variables, or a Secrets Manager id ──
PGHOST=your-db.xxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=ecom
PGUSER=ecom_loader
PGPASSWORD=change-me
PGSSLMODE=require
# PG_SECRET_ID=rds/ecom/loader          # instead of the five lines above

# ── Pinecone — either the API key, or a Secrets Manager id holding {"api_key": "..."} ──
PINECONE_API_KEY=pcsk_change-me
# PINECONE_SECRET_ID=ecom/pinecone
PINECONE_INDEX=ecom-kb
PINECONE_REGION=us-east-1
# KB_MODE=incremental                    # when the workbook holds changes only

# ── OpenAI — embeddings for the knowledge base (text-embedding-3-small) ──
OPENAI_API_KEY=sk-change-me
# OPENAI_SECRET_ID=ecom/openai           # instead: a Secrets Manager id holding {"api_key": "..."}

# ── AWS — RDS deploy and Secrets Manager use your normal AWS login ──
AWS_REGION=us-east-1
# AWS_PROFILE=default

# ── RDS created by `python run.py deploy` (all optional) ──
# RDS_INSTANCE=ecom-nlq-db
# RDS_INSTANCE_CLASS=db.t4g.micro
# After deploy, `run.py postgres` reads postgres/deployment.json — no PG* needed.
