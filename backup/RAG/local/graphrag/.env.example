OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pc-...

# The index built by the RAG notebooks. Read only.
INDEX_NAME=rag-docs
NAMESPACE=

# Neo4j Aura. These come from the credentials file Aura gives you when the instance
# is created — the password is shown once and never again.
#
# The scheme matters: Aura needs neo4j+s://, not bolt://.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# For a local Docker instance instead:
#   NEO4J_URI=bolt://localhost:7687
#   NEO4J_PASSWORD=password
